{
  "name": "decision-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval --env-file .env -j ${CONCURRENCY:-24} --no-progress-bar --no-table",
    "view": "PROMPTFOO_CONFIG_DIR=.promptfoo promptfoo view",
    "analyze": "tsx src/analyze.ts",
    "manifest": "tsx scripts/manifest.ts",
    "review": "tsx scripts/review.ts --frame game && tsx scripts/review.ts --frame narrative && tsx scripts/review-image.ts",
    "prereg": "tsx src/prereg.ts",
    "format": "prettier --write src scripts test"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.112",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.139",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "promptfoo": "^0.124.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
